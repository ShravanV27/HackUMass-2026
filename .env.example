NESSIE_API_KEY=
NESSIE_BASE_URL=https://v2-prod-api.nessieisreal.com
# Optional: Nessie sandbox customer ID mapped to DEMO_CUSTOMER_ID in live mode
NESSIE_CUSTOMER_ID=

DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# App / provider mode (mock by default)
USE_MOCK_DATA= # false to use actual APIs, set true for frontend testing
DEMO_CUSTOMER_ID=demo-customer-001 # current app user

# Opt-in live pytest suite (see docs/live_testing.md) — never required for ordinary pytest
# LIVE_TEST_DATABASE_URL=          # isolated DB; must differ from DATABASE_URL
# LIVE_TEST_ALLOW_SHARED_DB=       # set to "confirm" only if you accept shared-DB risk
# LIVE_TEST_GEMINI=                # set to 1 to allow Gemini live tests
# NESSIE_DESTRUCTIVE_API_KEY=      # dedicated key ≠ NESSIE_API_KEY
# CONFIRM_NESSIE_DESTRUCTIVE=      # must be I_UNDERSTAND for destructive tests
# CONFIRM_NESSIE_SEED=             # must be SEED to POST /data/seed
